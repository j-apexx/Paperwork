        <script type="text/javascript">
            // Adds the save/delete/error feedback code to all pages. Need to add the div with id "alert_container" and call from page code.
            function ShowMessageIcon(messageString, messagetype) {
                var cssclass;
                var messageIcon;
                switch (messagetype) {
                    case 'Success':
                        cssclass = 'alert-success';
                        messageIcon = "<i class='fas fa-check-circle' style='color:green;'></i>";
                        break;
                    case 'Error':
                        cssclass = 'alert-danger';
                        messageIcon = "<i class='fas fa-exclamation-circle' style='color: darkred;'></i>";
                        break;
                    case 'Warning':
                        cssclass = 'alert-warning';
                        messageIcon = "<i class='fas fa-exclamation-triangle' style='color: saddlebrown;'></i>";
                        break;
                    default:
                        cssclass = 'alert-info';
                        messageIcon = "<i class='fas fa-info-circle' style='color: darkblue;'></i>";
                }
                $('#alert_container').append('<div id="alert_div" style="display:inline; padding:3px;" class="alert alert-dismissible fade show '
                    + cssclass + '"><a href="#" data-dismiss="alert" >'
                    + '<span>' + messageIcon + ' ' + messageString + '</span></a></div>');
                window.setTimeout(function () { $('#alert_div').alert('close'); }, 3000);
            };

            // the following allows you to specify a specific alert container if more than one is on the page
            function ShowMessageByName(message, messagetype, containerName, duration) {
                var cssclass;
                var msgduration = duration;
                switch (messagetype) {
                    case 'Success':
                        cssclass = 'alert-success';
                        break;
                    case 'Error':
                        cssclass = 'alert-danger';
                        break;
                    case 'Warning':
                        cssclass = 'alert-warning';
                        break;
                    default:
                        cssclass = 'alert-info';
                }
                $('#' + containerName).append('<div id="alert_div" style="margin: 0 0.5%; -webkit-box-shadow: 3px 4px 6px #999;" class="alert alert-dismissible fade show '
                    + cssclass + '"><a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a><a href="#" data-dismiss="alert" ><strong>'
                    + messagetype + '!</strong> <span>' + message + '</span></a></div>');
                window.setTimeout(function () { $('#alert_div').alert('close'); }, msgduration);
            }

            // Code to call the Jquery UI Dialog box from any page
            function ShowPopup(titleString, message, messagetype) {
                $(function () {
                    switch (messagetype) {
                        case 'Success':
                            cssclass = 'alert-success';
                            break;
                        case 'Error':
                            cssclass = 'alert-danger';
                            break;
                        case 'Warning':
                            cssclass = 'alert-warning';
                            break;
                        default:
                            cssclass = 'alert-info';
                    }
                    $("#dialogBox").html(message);
                    $("#dialogBox").dialog({
                        title: titleString,
                        dialogClass: cssclass,
                        
                        buttons: {
                            Close: function () {
                                $(this).dialog('close');
                            }
                        },
                        modal: true,
                        show: {
                            effect: 'blind',
                            duration: 200
                        },
                        hide: {
                            effect: 'blind',
                            duration: 200
                        },
                        create: function () {
                            $(this).closest(".ui-dialog")
                                .find(".ui-dialog-buttonpane") // the first button
                                .addClass(cssclass);
                        },
                        width: 400
                    });
                });
            };
        </script>
