        <div id="DataSources">
            <asp:SqlDataSource ID="SqlDataSourceMyDistrictsMstr" runat="server" ConnectionString="<%$ ConnectionStrings:connPaperwork %>" 
                SelectCommand="SELECT DistrictID, RTRIM(DistrictName) + '-' + RTRIM(DistrictID) 'Desc'
                FROM [District] WHERE DistrictID IN (SELECT DistrictID FROM [UserDistrictAccess] WHERE Userid=@UserID) OR (@AccessLevel NOT IN ('User'))
                ORDER BY [DistrictName]">
                <SelectParameters>
                    <asp:SessionParameter Name="UserID" SessionField="CurrentUser" Type="String" />
                    <asp:SessionParameter Name="AccessLevel" SessionField="AccessLevel" Type="String" />
                </SelectParameters>
            </asp:SqlDataSource>
            <asp:SqlDataSource ID="SqlDataSourceMyDistrictsMstrPY" runat="server" ConnectionString="<%$ ConnectionStrings:connPaperwork %>" 
                SelectCommand="ActiveDistrictsListUser" SelectCommandType="StoredProcedure">
                <SelectParameters>
                    <asp:Parameter Name="ProgramYear" Type="String" />
                    <asp:SessionParameter Name="UserID" SessionField="CurrentUser" Type="String" />
                    <asp:SessionParameter Name="AccessLevel" SessionField="AccessLevel" Type="String" />
                </SelectParameters>
            </asp:SqlDataSource>
        </div>
        <div id="dialogBox" ></div>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>
