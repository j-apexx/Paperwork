    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <%--<script src="https://kit.fontawesome.com/1526bde3ce.js" crossorigin="anonymous"></script>--%>
    <%-- The following line loads the font awesome icons in a faster manner than the previous line --%>
    <script type="text/javascript"> (function () { var css = document.createElement('link'); css.href = 'https://use.fontawesome.com/releases/v5.1.0/css/all.css'; css.rel = 'stylesheet'; css.type = 'text/css'; document.getElementsByTagName('head')[0].appendChild(css); })(); </script>
</head>
<body>
    <form id="MainForm" runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="jquery.ui.combined" />
                <asp:ScriptReference Name="bootstrap" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
            
        </asp:ScriptManager>
        <script type="text/javascript">
            // Adds the save/delete/error feedback code to all pages. Need to add the div with id "alert_container" and call from page code.
            function ShowMessageIcon(messageString, messagetype) {
                var cssclass;
                var messageIcon;
                switch (messagetype) {
                    case 'Success':
                        cssclass = 'alert-success';
                        messageIcon = "<i class='fas fa-check-circle' style='color:green;'></i>";
                        break;
                    case 'Error':
                        cssclass = 'alert-danger';
                        messageIcon = "<i class='fas fa-exclamation-circle' style='color: darkred;'></i>";
                        break;
                    case 'Warning':
                        cssclass = 'alert-warning';
                        messageIcon = "<i class='fas fa-exclamation-triangle' style='color: saddlebrown;'></i>";
                        break;
                    default:
                        cssclass = 'alert-info';
                        messageIcon = "<i class='fas fa-info-circle' style='color: darkblue;'></i>";
                }
                $('#alert_container').append('<div id="alert_div" style="display:inline; padding:3px;" class="alert alert-dismissible fade show '
                    + cssclass + '"><a href="#" data-dismiss="alert" >'
                    + '<span>' + messageIcon + ' ' + messageString + '</span></a></div>');
                window.setTimeout(function () { $('#alert_div').alert('close'); }, 3000);
            };
        </script>
