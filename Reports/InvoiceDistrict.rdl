    <DataSet Name="DataSetOSales">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProgramYear">
            <Value>=Parameters!ProgramYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@OtherSalesDate">
            <Value>=Parameters!RecapDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@OtherSalesDate2">
            <Value>=Parameters!RecapDate2.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  OtherSales.OtherSalesAmount
FROM
  OtherSales
WHERE
  OtherSales.ProgramYear = @ProgramYear
  AND OtherSales.DistrictID = @DistrictID
  AND OtherSales.OtherSalesDate &gt;= @OtherSalesDate
  AND OtherSales.OtherSalesDate &lt;= @OtherSalesDate2</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="OtherSales" ColumnName="OtherSalesAmount" />
            </SelectedColumns>
            <Filters>
              <Filter Operator="=" Param="True">
                <ColumnExpression ColumnOwner="OtherSales" ColumnName="ProgramYear" />
              </Filter>
              <Filter Operator="=" Param="True">
                <ColumnExpression ColumnOwner="OtherSales" ColumnName="DistrictID" />
              </Filter>
              <Filter Operator="&gt;=" Param="True">
                <ColumnExpression ColumnOwner="OtherSales" ColumnName="OtherSalesDate" />
              </Filter>
              <Filter Operator="&lt;=" Param="True">
                <ColumnExpression ColumnOwner="OtherSales" ColumnName="OtherSalesDate" />
              </Filter>
            </Filters>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
      <Fields>
        <Field Name="OtherSalesAmount">
          <DataField>OtherSalesAmount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
