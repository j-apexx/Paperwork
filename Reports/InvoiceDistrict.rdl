    <DataSet Name="DataSetBDGTS">
      <Query>
        <DataSourceName>DataSourceBDGTS</DataSourceName>
        <CommandText>SELECT
  vwBDGT_Totals.CostPerMeal
  ,vwBDGT_Totals.MealEquivalentFactor
  ,vwBDGT_Totals.CBS_FSMCAdmin
  ,vwBDGT_Totals.CBS_FSMCMgmt
  ,vwBDGT_Totals.BidNumber
  ,vwBDGT_Totals.BudgetYear
FROM
  vwBDGT_Totals
WHERE
  vwBDGT_Totals.ACTIVE = 1</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="vwBDGT_Totals" ColumnName="CostPerMeal" />
              <ColumnExpression ColumnOwner="vwBDGT_Totals" ColumnName="MealEquivalentFactor" />
              <ColumnExpression ColumnOwner="vwBDGT_Totals" ColumnName="CBS_FSMCAdmin" />
              <ColumnExpression ColumnOwner="vwBDGT_Totals" ColumnName="CBS_FSMCMgmt" />
              <ColumnExpression ColumnOwner="vwBDGT_Totals" ColumnName="BidNumber" />
              <ColumnExpression ColumnOwner="vwBDGT_Totals" ColumnName="BudgetYear" />
            </SelectedColumns>
            <Filters>
              <Filter Operator="=">
                <ColumnExpression ColumnOwner="vwBDGT_Totals" ColumnName="ACTIVE" />
                <FilterValue>1</FilterValue>
              </Filter>
            </Filters>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
