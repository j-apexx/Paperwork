                    <TablixCell>
                      <CellContents>
                        <Textbox Name="BreakfastCPM">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Lookup(Parameters!DistrictID.Value+Fields!BudgetYear.Value, Fields!BidNumber.Value + Fields!BudgetYear.Value, Fields!CostPerMeal.Value, "DataSetBDGTS")</Value>
