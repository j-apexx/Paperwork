    <DataSet Name="DataSetRecaps">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProgramYear">
            <Value>=Parameters!ProgramYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@RecapDate">
            <Value>=Parameters!RecapDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@RecapDate2">
            <Value>=Parameters!RecapDate2.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  RecapEntry.BPaidElem
  ,RecapEntry.BPaidJr
  ,RecapEntry.BPaidSr
  ,RecapEntry.BReduced
  ,RecapEntry.BFree
  ,ProgramYear.BudgetYear
  ,RecapEntry.LPaidElem
  ,RecapEntry.LPaidJr
  ,RecapEntry.LPaidSr
  ,RecapEntry.LTier1
  ,RecapEntry.LTier2
  ,RecapEntry.LReduced
  ,RecapEntry.LReducedTier1
  ,RecapEntry.LFree
  ,RecapEntry.LFreeTier1
  ,RecapEntry.LFreeTier2
  ,RecapEntry.LStuAla
  ,RecapEntry.LAdultAla
  ,RecapEntry.LOtherAla1
  ,RecapEntry.BStuAla
  ,RecapEntry.BAdultAla
FROM
  ProgramYear
  LEFT OUTER JOIN RecapEntry
    ON ProgramYear.ProgramYear = RecapEntry.ProgramYear
WHERE
  RecapEntry.ProgramYear LIKE @ProgramYear
  AND RecapEntry.DistrictID LIKE @DistrictID
  AND RecapEntry.RecapDate &gt;= @RecapDate
  AND RecapEntry.RecapDate &lt;= @RecapDate2</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <AutoJoin>False</AutoJoin>
            <SelectedColumns>
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="BPaidElem" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="BPaidJr" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="BPaidSr" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="BReduced" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="BFree" />
              <ColumnExpression ColumnOwner="ProgramYear" ColumnName="BudgetYear" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LPaidElem" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LPaidJr" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LPaidSr" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LTier1" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LTier2" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LReduced" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LReducedTier1" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LFree" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LFreeTier1" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LFreeTier2" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LStuAla" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LAdultAla" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="LOtherAla1" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="BStuAla" />
              <ColumnExpression ColumnOwner="RecapEntry" ColumnName="BAdultAla" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="ProgramYear" />
              <Join Type="LEFT OUTER JOIN" ColumnOwner="RecapEntry">
                <On>
                  <From ColumnOwner="ProgramYear" ColumnName="ProgramYear" />
                  <To ColumnOwner="RecapEntry" ColumnName="ProgramYear" />
                </On>
              </Join>
            </Joins>
            <Filters>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="RecapEntry" ColumnName="ProgramYear" />
              </Filter>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="RecapEntry" ColumnName="DistrictID" />
              </Filter>
              <Filter Operator="&gt;=" Param="True">
                <ColumnExpression ColumnOwner="RecapEntry" ColumnName="RecapDate" />
              </Filter>
              <Filter Operator="&lt;=" Param="True">
                <ColumnExpression ColumnOwner="RecapEntry" ColumnName="RecapDate" />
              </Filter>
            </Filters>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
