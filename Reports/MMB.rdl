    <DataSet Name="DataSetMMBTrx">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProgramYear">
            <Value>=Parameters!ProgramYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MMBDate">
            <Value>=Parameters!MMBDateStart.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MMBDate2">
            <Value>=Parameters!MMBDateEnd.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  MMBTransactions.ProgramYear
  ,MMBTransactions.DistrictID
  ,MMBTransactions.ProductCode
  ,MMBTransactions.VendorID
  ,MMBTransactions.MMBDate
  ,MMBTransactions.SchoolNum
  ,MMBTransactions.Quantity
  ,MMBTransactions.Price
  ,MMBTransactions.MilkItem
  ,Vendors.VENDNAME
  ,MMBItems.ProductName
FROM
  MMBTransactions
  LEFT OUTER JOIN Vendors
    ON MMBTransactions.VendorID = Vendors.VENDORID
  LEFT OUTER JOIN MMBItems
    ON MMBTransactions.ProgramYear = MMBItems.ProgramYear AND MMBTransactions.DistrictID = MMBItems.DistrictID AND MMBTransactions.ProductCode = MMBItems.ProductCode
WHERE
  MMBTransactions.ProgramYear LIKE @ProgramYear
  AND MMBTransactions.DistrictID LIKE @DistrictID
  AND MMBTransactions.MMBDate &gt;= @MMBDate
  AND MMBTransactions.MMBDate &lt;= @MMBDate2</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <AutoJoin>False</AutoJoin>
            <SelectedColumns>
              <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="ProgramYear" />
              <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="DistrictID" />
              <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="ProductCode" />
              <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="VendorID" />
              <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="MMBDate" />
              <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="SchoolNum" />
              <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="Quantity" />
              <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="Price" />
              <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="MilkItem" />
              <ColumnExpression ColumnOwner="Vendors" ColumnName="VENDNAME" />
              <ColumnExpression ColumnOwner="MMBItems" ColumnName="ProductName" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="MMBTransactions" />
              <Join Type="LEFT OUTER JOIN" ColumnOwner="Vendors">
                <On>
                  <From ColumnOwner="MMBTransactions" ColumnName="VendorID" />
                  <To ColumnOwner="Vendors" ColumnName="VENDORID" />
                </On>
              </Join>
              <Join Type="LEFT OUTER JOIN" ColumnOwner="MMBItems">
                <On>
                  <From ColumnOwner="MMBTransactions" ColumnName="ProgramYear" />
                  <To ColumnOwner="MMBItems" ColumnName="ProgramYear" />
                </On>
                <On>
                  <From ColumnOwner="MMBTransactions" ColumnName="DistrictID" />
                  <To ColumnOwner="MMBItems" ColumnName="DistrictID" />
                </On>
                <On>
                  <From ColumnOwner="MMBTransactions" ColumnName="ProductCode" />
                  <To ColumnOwner="MMBItems" ColumnName="ProductCode" />
                </On>
              </Join>
            </Joins>
            <Filters>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="ProgramYear" />
              </Filter>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="DistrictID" />
              </Filter>
              <Filter Operator="&gt;=" Param="True">
                <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="MMBDate" />
              </Filter>
              <Filter Operator="&lt;=" Param="True">
                <ColumnExpression ColumnOwner="MMBTransactions" ColumnName="MMBDate" />
              </Filter>
            </Filters>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
      <Fields>
        <Field Name="ProgramYear">
          <DataField>ProgramYear</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DistrictID">
          <DataField>DistrictID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProductCode">
          <DataField>ProductCode</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="VendorID">
