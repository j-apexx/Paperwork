<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSourcePaperwork">
      <DataSourceReference>/PaperworkWeb/DS_Paperwork</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>55da70ab-c34e-4bcf-a850-e533cb4f81a7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSetDistricts">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProgramYear">
            <Value>=Parameters!ProgramYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  DistrictYearInfo.ProgramYear
  ,District.DistrictID
  ,District.DistrictName
FROM
  DistrictYearInfo
  INNER JOIN District
    ON DistrictYearInfo.DistrictID = District.DistrictID
WHERE
  DistrictYearInfo.DistrictID LIKE @DistrictID
  AND DistrictYearInfo.ProgramYear LIKE @ProgramYear
  AND DistrictYearInfo.AcctType = 2
  AND District.Inactive = 0
ORDER BY District.DistrictName</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <AutoJoin>False</AutoJoin>
            <SelectedColumns>
              <ColumnExpression ColumnOwner="DistrictYearInfo" ColumnName="ProgramYear" />
              <ColumnExpression ColumnOwner="District" ColumnName="DistrictID" />
              <ColumnExpression ColumnOwner="District" ColumnName="DistrictName" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="DistrictYearInfo" />
              <Join Type="INNER JOIN" ColumnOwner="District">
                <On>
                  <From ColumnOwner="DistrictYearInfo" ColumnName="DistrictID" />
                  <To ColumnOwner="District" ColumnName="DistrictID" />
                </On>
              </Join>
            </Joins>
            <Filters>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="DistrictYearInfo" ColumnName="DistrictID" />
              </Filter>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="DistrictYearInfo" ColumnName="ProgramYear" />
              </Filter>
              <Filter Operator="=">
                <ColumnExpression ColumnOwner="DistrictYearInfo" ColumnName="AcctType" />
                <FilterValue>2</FilterValue>
              </Filter>
              <Filter Operator="=">
                <ColumnExpression ColumnOwner="District" ColumnName="Inactive" />
                <FilterValue>0</FilterValue>
              </Filter>
            </Filters>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
      <Fields>
        <Field Name="DistrictID">
          <DataField>DistrictID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DistrictName">
          <DataField>DistrictName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProgramYear">
          <DataField>ProgramYear</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSetProgramYears">
      <SharedDataSet>
        <SharedDataSetReference>/PaperworkWeb/ProgramYears</SharedDataSetReference>
        <rd:ReportServerUrl>http://nu-sql-irw-1/reportserver_DYNAMICSGP</rd:ReportServerUrl>
      </SharedDataSet>
      <Fields>
        <Field Name="ProgramYear">
          <DataField>ProgramYear</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSetDates">
      <SharedDataSet>
        <SharedDataSetReference>/PaperworkWeb/DatasetStandardDates</SharedDataSetReference>
        <rd:ReportServerUrl>http://nu-sql-irw-1/reportserver_DYNAMICSGP</rd:ReportServerUrl>
      </SharedDataSet>
      <Fields>
        <Field Name="PREVMONTHStart">
          <DataField>PREVMONTHStart</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PREVMONTHEnd">
          <DataField>PREVMONTHEnd</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="CURRMONTHStart">
          <DataField>CURRMONTHStart</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="CURRMONTHEnd">
          <DataField>CURRMONTHEnd</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
