    <DataSet Name="DataSetProgramYearBudgetID">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProgramYear">
            <Value>=Parameters!ProgramYear.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  ProgramYear.BudgetYear
FROM
  ProgramYear
WHERE
  ProgramYear.ProgramYear LIKE @ProgramYear</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="ProgramYear" ColumnName="BudgetYear" />
            </SelectedColumns>
            <Filters>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="ProgramYear" ColumnName="ProgramYear" />
              </Filter>
            </Filters>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
      <Fields>
        <Field Name="BudgetYear">
          <DataField>BudgetYear</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSetPayTax">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProgramYear">
            <Value>=Parameters!ProgramYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate2">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  PayTax.Gross
  ,PayTax.Hours
  ,PayTax.ProdHrs
  ,PayTax.NonProdHrs
  ,PayTax.SpecFunctionHrs
  ,PayTax.FUTA
  ,PayTax.Medicare
  ,PayTax.PASUI
  ,PayTax.OHSUI
  ,PayTax.SocSec
  ,PayTax.Uniforms
  ,PayTax.PAPitC
  ,PayTax.PayAccrual
  ,PayTax.TaxAccrual
FROM
  PayTax
WHERE
  PayTax.ProgramYear = @ProgramYear
  AND PayTax.DistrictID = @DistrictID
  AND PayTax.EndDate &gt;= @EndDate
  AND PayTax.EndDate &lt;= @EndDate2</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="PayTax" ColumnName="Gross" />
