    <DataSet Name="DataSetDistPayroll">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProgramYear">
            <Value>=Parameters!ProgramYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PayDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PayDate2">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  Payroll.Hours
  ,Payroll.Rate
  ,Payroll.OtherPay
  ,Payroll.Health
FROM
  Payroll
WHERE
  Payroll.ProgramYear = @ProgramYear
  AND Payroll.DistrictID = @DistrictID
  AND Payroll.PayDate &gt;= @PayDate
  AND Payroll.PayDate &lt;= @PayDate2</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Payroll" ColumnName="Hours" />
              <ColumnExpression ColumnOwner="Payroll" ColumnName="Rate" />
              <ColumnExpression ColumnOwner="Payroll" ColumnName="OtherPay" />
              <ColumnExpression ColumnOwner="Payroll" ColumnName="Health" />
            </SelectedColumns>
            <Filters>
              <Filter Operator="=" Param="True">
                <ColumnExpression ColumnOwner="Payroll" ColumnName="ProgramYear" />
              </Filter>
              <Filter Operator="=" Param="True">
                <ColumnExpression ColumnOwner="Payroll" ColumnName="DistrictID" />
              </Filter>
              <Filter Operator="&gt;=" Param="True">
                <ColumnExpression ColumnOwner="Payroll" ColumnName="PayDate" />
              </Filter>
              <Filter Operator="&lt;=" Param="True">
                <ColumnExpression ColumnOwner="Payroll" ColumnName="PayDate" />
              </Filter>
            </Filters>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
      <Fields>
        <Field Name="Hours">
          <DataField>Hours</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Rate">
          <DataField>Rate</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OtherPay">
          <DataField>OtherPay</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Health">
          <DataField>Health</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalPay">
          <Value>=(Fields!Hours.Value*Fields!Rate.Value) + Fields!OtherPay.Value</Value>
        </Field>
      </Fields>
    </DataSet>
