                    <TablixCell>
                      <CellContents>
                        <Textbox Name="BOFee">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=ROUND(  IIF(Sum(Fields!BillingPeriods.Value, "DataSetBudget")=0, 0,
Sum(Fields!BusinessOffExp.Value, "DataSetBudget") / IIF(Sum(Fields!BillingPeriods.Value, "DataSetBudget")=0, 1, Sum(Fields!BillingPeriods.Value, "DataSetBudget")))  ,2)</Value>
                                  <Style>
                                    <FontFamily>Arial</FontFamily>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>#,0.00;(#,0.00)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
