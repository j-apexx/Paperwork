                      <CellContents>
                        <Textbox Name="CashBud">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=(Sum(Fields!DailyCashBudget.Value, "DataSetBudget") + (Sum(Fields!PDE3086Revenue.Value, "DataSetBudget")/Sum(Fields!DaysOfSvcLunch.Value, "DataSetBudget")))  * Sum(Fields!LunchDay.Value, "DataSetRecapsYTD")</Value>
                                  <Style>
