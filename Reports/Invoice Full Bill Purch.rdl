  <DataSets>
    <DataSet Name="DataSetInvoice">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ProgramYear">
            <Value>=Parameters!ProgramYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PostDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PostDate2">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  District.DistrictAddress1
  ,District.DistrictCity
  ,District.DistrictState
  ,District.DistrictZip
  ,District.DistrictAddress2
  ,District.DistrictContact
  ,District.DistrictFullName
  ,DistrictYearInfo.ProgramYear AS [DistrictYearInfo ProgramYear]
  ,Purchases.InvoiceDate
  ,Purchases.PostDate
  ,Purchases.Groceries
  ,Purchases.Paper
  ,Purchases.Cleaning
  ,Purchases.Other
  ,Purchases.Milk
  ,Purchases.ProgramYear AS [Purchases ProgramYear]
  ,District.DistrictID
FROM
  District
  LEFT OUTER JOIN DistrictYearInfo
    ON District.DistrictID = DistrictYearInfo.DistrictID
  LEFT OUTER JOIN Purchases
    ON DistrictYearInfo.ProgramYear = Purchases.ProgramYear AND DistrictYearInfo.DistrictID = Purchases.DistrictID
WHERE
  District.DistrictID LIKE @DistrictID
  AND DistrictYearInfo.ProgramYear LIKE @ProgramYear
  AND Purchases.PostDate &gt;= @PostDate
  AND Purchases.PostDate &lt;= @PostDate2</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <AutoJoin>False</AutoJoin>
            <SelectedColumns>
              <ColumnExpression ColumnOwner="District" ColumnName="DistrictAddress1" />
              <ColumnExpression ColumnOwner="District" ColumnName="DistrictCity" />
              <ColumnExpression ColumnOwner="District" ColumnName="DistrictState" />
              <ColumnExpression ColumnOwner="District" ColumnName="DistrictZip" />
              <ColumnExpression ColumnOwner="District" ColumnName="DistrictAddress2" />
              <ColumnExpression ColumnOwner="District" ColumnName="DistrictContact" />
              <ColumnExpression ColumnOwner="District" ColumnName="DistrictFullName" />
              <ColumnExpression ColumnOwner="DistrictYearInfo" ColumnName="ProgramYear" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="InvoiceDate" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="PostDate" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Groceries" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Paper" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Cleaning" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Other" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Milk" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="ProgramYear" />
              <ColumnExpression ColumnOwner="District" ColumnName="DistrictID" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="District" />
              <Join Type="LEFT OUTER JOIN" ColumnOwner="DistrictYearInfo">
                <On>
                  <From ColumnOwner="District" ColumnName="DistrictID" />
                  <To ColumnOwner="DistrictYearInfo" ColumnName="DistrictID" />
                </On>
              </Join>
              <Join Type="LEFT OUTER JOIN" ColumnOwner="Purchases">
                <On>
                  <From ColumnOwner="DistrictYearInfo" ColumnName="ProgramYear" />
                  <To ColumnOwner="Purchases" ColumnName="ProgramYear" />
                </On>
                <On>
                  <From ColumnOwner="DistrictYearInfo" ColumnName="DistrictID" />
                  <To ColumnOwner="Purchases" ColumnName="DistrictID" />
                </On>
              </Join>
            </Joins>
            <Filters>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="District" ColumnName="DistrictID" />
              </Filter>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="DistrictYearInfo" ColumnName="ProgramYear" />
              </Filter>
              <Filter Operator="&gt;=" Param="True">
                <ColumnExpression ColumnOwner="Purchases" ColumnName="PostDate" />
              </Filter>
              <Filter Operator="&lt;=" Param="True">
                <ColumnExpression ColumnOwner="Purchases" ColumnName="PostDate" />
              </Filter>
            </Filters>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
      <Fields>
        <Field Name="DistrictAddress1">
          <DataField>DistrictAddress1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DistrictCity">
          <DataField>DistrictCity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DistrictState">
