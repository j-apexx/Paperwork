                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=ROUND(  (Sum(Fields!DailyExpenses.Value, "DataSetBudget") - (Sum(Fields!CBS_FSMCMgmt.Value, "DataSetBudget")/Sum(Fields!DaysOfSvcLunch.Value, "DataSetBudget")) - (Sum(Fields!CBS_FSMCAdmin.Value, "DataSetBudget")/Sum(Fields!DaysOfSvcLunch.Value, "DataSetBudget")) - (Sum(Fields!FSDCosts.Value, "DataSetBudget")/Sum(Fields!DaysOfSvcLunch.Value, "DataSetBudget")) - (Sum(Fields!DistrictCosts.Value, "DataSetBudget")/Sum(Fields!DaysOfSvcLunch.Value, "DataSetBudget")) - (Sum(Fields!SFALabor.Value, "DataSetBudget") / Sum(Fields!DaysOfSvcLunch.Value, "DataSetBudget"))  ) * Sum(Fields!LunchDay.Value, "DataSetRecapsYTD"), 2)</Value>
                                  <Style>
                                    <FontFamily>Arial</FontFamily>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
