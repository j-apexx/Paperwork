          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Purchases_ProgramYear">
          <DataField>Purchases ProgramYear</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DistrictID">
          <DataField>DistrictID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MonthNum">
          <Value>=IIF(MONTH(Parameters!EndDate.Value)&lt;7, MONTH(Parameters!EndDate.Value)+6, MONTH(Parameters!EndDate.Value)-6)</Value>
        </Field>
      </Fields>
