            <Value>=IIF(Month(Parameters!StartDate.Value)=6 , "*OPEN*" , CSTR(YEAR(Parameters!StartDate.Value)) + "-" + RIGHT("0" + CSTR(MONTH(Parameters!StartDate.Value)),2) )</Value>
          </QueryParameter>
          <QueryParameter Name="@YearMonth2">
            <Value>=IIF(Month(Parameters!EndDate.Value)=6 , "*OPEN*" , CSTR(YEAR(Parameters!EndDate.Value)) + "-" + RIGHT("0" + CSTR(MONTH(Parameters!EndDate.Value)),2) )</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  Inventory.USDAProteinOpen
  ,Inventory.USDAProteinRcvd
