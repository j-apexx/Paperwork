    <DataSet Name="DataSetRecaps">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@RecapDate">
            <Value>=Parameters!RecapDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@RecapDate2">
            <Value>=Parameters!RecapDate2.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  District.DistrictID
  ,District.DistrictName
  ,DistrictSchools.SchoolName
  ,RecapEntry.BreakfastDay
  ,RecapEntry.LunchDay
  ,RecapEntry.BPaidElem
  ,RecapEntry.BPaidJr
  ,RecapEntry.BPaidSr
  ,RecapEntry.BReduced
  ,RecapEntry.BFree
  ,RecapEntry.BPaidLrn
  ,RecapEntry.BReducedLrn
  ,RecapEntry.BFreeLrn
  ,RecapEntry.BStuAla
  ,RecapEntry.BAdultAla
  ,RecapEntry.BAdvanced
  ,RecapEntry.BRedeemed
  ,RecapEntry.BRepaid
  ,RecapEntry.BCharges
  ,RecapEntry.BDeposit
  ,RecapEntry.LPaidElem
  ,RecapEntry.LPaidJr
  ,RecapEntry.LPaidSr
  ,RecapEntry.LTier1
  ,RecapEntry.LTier2
  ,RecapEntry.LReduced
  ,RecapEntry.LReducedTier1
  ,RecapEntry.LFree
  ,RecapEntry.LFreeTier1
  ,RecapEntry.LFreeTier2
  ,RecapEntry.LPaidLrn
  ,RecapEntry.LReducedLrn
  ,RecapEntry.LFreeLrn
  ,RecapEntry.LStuAla
  ,RecapEntry.LAdultAla
  ,RecapEntry.LOtherAla1
  ,RecapEntry.LVendAla
  ,RecapEntry.LAdvanced
  ,RecapEntry.LRedeemed
  ,RecapEntry.LRepaid
  ,RecapEntry.LCharges
  ,RecapEntry.OPaidSnack
  ,RecapEntry.OReducedSnack
  ,RecapEntry.OFreeSnack
  ,RecapEntry.SpecialFunctionSale
  ,RecapEntry.SpecialFunctionColl
  ,RecapEntry.SpecialFunctionComm
  ,RecapEntry.USDASale
  ,RecapEntry.USDAColl
  ,RecapEntry.OtherSale1
  ,RecapEntry.OtherColl1
  ,RecapEntry.OtherSale2
  ,RecapEntry.OtherColl2
  ,RecapEntry.OnlineAdvance
  ,RecapEntry.Adjustment
  ,RecapEntry.Deposit
  ,RecapEntry.OtherSale1Cat
  ,RecapEntry.OtherColl1Cat
  ,RecapEntry.EditCheckComments
  ,RecapEntry.RecapComments
  ,RecapEntry.OtherSale2Cat
  ,RecapEntry.OtherColl2Cat
  ,DistrictSchools.SchoolNum
  ,vw_RecapTotals.BSaleTotal
  ,vw_RecapTotals.LSaleTotal
  ,vw_RecapTotals.Cash
  ,vw_RecapTotals.TotalSale
  ,vw_RecapTotals.AdvancedTotal
  ,vw_RecapTotals.RedeemedTotal
  ,vw_RecapTotals.ChargeRepaidTotal
  ,vw_RecapTotals.ChargeMadeTotal
  ,RecapEntry.R_AF
  ,RecapEntry.R_Enrollment
FROM
  District
  LEFT OUTER JOIN DistrictSchools
    ON District.DistrictID = DistrictSchools.DistrictID
  LEFT OUTER JOIN RecapEntry
    ON DistrictSchools.DistrictID = RecapEntry.DistrictID AND DistrictSchools.SchoolNum = RecapEntry.SchoolNum
  LEFT OUTER JOIN vw_RecapTotals
    ON RecapEntry.ProgramYear = vw_RecapTotals.ProgramYear AND RecapEntry.DistrictID = vw_RecapTotals.DistrictID AND RecapEntry.SchoolNum = vw_RecapTotals.SchoolNum AND RecapEntry.RecapDate = vw_RecapTotals.RecapDate
WHERE
  District.DistrictID LIKE @DistrictID
  AND RecapEntry.RecapDate &gt;= @RecapDate
  AND RecapEntry.RecapDate &lt;= @RecapDate2</CommandText>
