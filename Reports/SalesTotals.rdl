    <DataSet Name="DataSetDayCounts">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!RecapDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!RecapDate2.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT MAX(BreakfastDays) BreakfastDays
	,MAX(LunchDays) LunchDays
FROM
(SELECT [ProgramYear]
      ,[DistrictID]
      ,[SchoolNum]
      --,[RecapDate]
      ,COUNT(CASE BreakfastDay WHEN 1 THEN 1 ELSE NULL END) BreakfastDays
      ,COUNT(CASE [LunchDay] WHEN 1 THEN 1 ELSE NULL END) LunchDays
  FROM [PaperworkWeb].[dbo].[RecapEntry]
WHERE [DistrictID]=@DistrictID AND [RecapDate]&gt;=@StartDate AND [RecapDate]&lt;=@EndDate
  GROUP BY [ProgramYear],[DistrictID],[SchoolNum]) DaysGroup
  GROUP BY [ProgramYear],[DistrictID]</CommandText>
      </Query>
      <Fields>
        <Field Name="BreakfastDays">
          <DataField>BreakfastDays</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="LunchDays">
          <DataField>LunchDays</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
