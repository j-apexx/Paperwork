            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="District" />
              <Join Type="LEFT OUTER JOIN" ColumnOwner="DistrictSchools">
                <On>
                  <From ColumnOwner="District" ColumnName="DistrictID" />
                  <To ColumnOwner="DistrictSchools" ColumnName="DistrictID" />
                </On>
              </Join>
              <Join Type="LEFT OUTER JOIN" ColumnOwner="RecapEntry">
                <On>
                  <From ColumnOwner="DistrictSchools" ColumnName="DistrictID" />
                  <To ColumnOwner="RecapEntry" ColumnName="DistrictID" />
                </On>
                <On>
                  <From ColumnOwner="DistrictSchools" ColumnName="SchoolNum" />
                  <To ColumnOwner="RecapEntry" ColumnName="SchoolNum" />
                </On>
              </Join>
              <Join Type="LEFT OUTER JOIN" ColumnOwner="vw_RecapTotals">
                <On>
                  <From ColumnOwner="RecapEntry" ColumnName="ProgramYear" />
                  <To ColumnOwner="vw_RecapTotals" ColumnName="ProgramYear" />
                </On>
                <On>
                  <From ColumnOwner="RecapEntry" ColumnName="DistrictID" />
                  <To ColumnOwner="vw_RecapTotals" ColumnName="DistrictID" />
                </On>
                <On>
                  <From ColumnOwner="RecapEntry" ColumnName="SchoolNum" />
