                </On>
                <On>
                  <From ColumnOwner="RecapEntry" ColumnName="RecapDate" />
                  <To ColumnOwner="vw_RecapTotals" ColumnName="RecapDate" />
                </On>
              </Join>
            </Joins>
            <Filters>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="District" ColumnName="DistrictID" />
              </Filter>
              <Filter Operator="&gt;=" Param="True">
