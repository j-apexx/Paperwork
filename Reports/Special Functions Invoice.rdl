                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=(Fields!FoodCost.Value + Fields!PaperCleanSuppl.Value + Fields!Mileage.Value + Fields!FSDCosts.Value + Fields!TNGLabor.Value + (Fields!TNGLabor.Value * Fields!TNGFringePct.Value) + Fields!DistrictLabor.Value + (Fields!DistrictLabor.Value * Fields!DistrictFringePct.Value) + SUM(Fields!MiscAmount.Value) )</Value>
                                  <Style>
                                    <FontFamily>Arial</FontFamily>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
