            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="SPFNInvoiceHDR" />
              <Join Type="LEFT OUTER JOIN" ColumnOwner="SPFNInvoiceLines">
                <On>
                  <From ColumnOwner="SPFNInvoiceHDR" ColumnName="ProgramYear" />
                  <To ColumnOwner="SPFNInvoiceLines" ColumnName="ProgramYear" />
