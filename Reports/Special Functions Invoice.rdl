  <DataSets>
    <DataSet Name="DataSetSpecialFunctions">
      <Query>
        <DataSourceName>DataSourcePPW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProgramYear">
            <Value>=Parameters!ProgramYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@InvoiceNumber">
            <Value>=Parameters!InvoiceNumber.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  SPFNInvoiceHDR.ProgramYear
  ,SPFNInvoiceHDR.DistrictID
  ,SPFNInvoiceHDR.InvoiceNumber
  ,SPFNInvoiceHDR.CreatedDate
  ,SPFNInvoiceHDR.CreatedUser
  ,SPFNInvoiceHDR.Locked
  ,SPFNInvoiceHDR.OrgBilled
  ,SPFNInvoiceHDR.OrgContact
  ,SPFNInvoiceHDR.FunctionDate
  ,SPFNInvoiceHDR.BillingDate
  ,SPFNInvoiceHDR.OrgRemitTo
  ,SPFNInvoiceHDR.SpecialFunctionDesc
  ,SPFNInvoiceHDR.FoodCost
  ,SPFNInvoiceHDR.PaperCleanSuppl
  ,SPFNInvoiceHDR.Mileage
  ,SPFNInvoiceHDR.FSDCosts
  ,SPFNInvoiceHDR.TNGLabor
  ,SPFNInvoiceHDR.TNGFringePct
  ,SPFNInvoiceHDR.DistrictLabor
  ,SPFNInvoiceHDR.DistrictFringePct
  ,SPFNInvoiceHDR.MarkupType
  ,SPFNInvoiceHDR.MarkupDlr
  ,SPFNInvoiceHDR.MarkupPct
  ,SPFNInvoiceHDR.InvoiceNotes
  ,SPFNInvoiceLines.LineNumber
  ,SPFNInvoiceLines.MiscDescription
  ,SPFNInvoiceLines.MiscAmount
  ,District.DistrictName
  ,District.DistrictContact
  ,DistrictYearInfo.AcctType
FROM
  SPFNInvoiceHDR
  LEFT OUTER JOIN SPFNInvoiceLines
    ON SPFNInvoiceHDR.ProgramYear = SPFNInvoiceLines.ProgramYear AND SPFNInvoiceHDR.DistrictID = SPFNInvoiceLines.DistrictID AND SPFNInvoiceHDR.InvoiceNumber = SPFNInvoiceLines.InvoiceNumber
  LEFT OUTER JOIN District
    ON SPFNInvoiceHDR.DistrictID = District.DistrictID
  LEFT OUTER JOIN DistrictYearInfo
    ON SPFNInvoiceHDR.ProgramYear = DistrictYearInfo.ProgramYear AND SPFNInvoiceHDR.DistrictID = DistrictYearInfo.DistrictID
WHERE
  SPFNInvoiceHDR.ProgramYear = @ProgramYear
  AND SPFNInvoiceHDR.DistrictID = @DistrictID
  AND SPFNInvoiceHDR.InvoiceNumber = @InvoiceNumber</CommandText>
