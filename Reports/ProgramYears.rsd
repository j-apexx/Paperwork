<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>/PaperworkWeb/DS_Paperwork</DataSourceReference>
      <CommandText>SELECT
  ProgramYear.ProgramYear
FROM
  ProgramYear
ORDER BY ProgramYear DESC</CommandText>
      <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
    </Query>
    <Fields>
      <Field Name="ProgramYear">
        <DataField>ProgramYear</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
  <rd:ReportServerUrl>http://nu-sql-irw-1/reportserver_DYNAMICSGP</rd:ReportServerUrl>
</SharedDataSet>