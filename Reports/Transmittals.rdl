  <DataSets>
    <DataSet Name="DataSetDistricts">
      <SharedDataSet>
        <SharedDataSetReference>/PaperworkWeb/Districts</SharedDataSetReference>
        <rd:ReportServerUrl>http://localhost/reportserver</rd:ReportServerUrl>
      </SharedDataSet>
      <Fields>
        <Field Name="DistrictID">
          <DataField>DistrictID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DistrictName">
          <DataField>DistrictName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSetTransmittals2">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PostDate">
            <Value>=Parameters!PostDateBeginning.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PostDate2">
            <Value>=Parameters!PostDateEnding.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  Purchases.DistrictID
  ,Purchases.InvoiceDate
  ,Purchases.PostDate
  ,Purchases.VendorID
  ,Purchases.InvoiceNumber
  ,Purchases.Groceries
  ,Purchases.Paper
  ,Purchases.Cleaning
  ,Purchases.Other
  ,Purchases.OtherCategoryID
  ,Purchases.Counter
  ,Purchases.Imported
  ,Purchases.ImportDate
  ,Purchases.PurchaseComments
  ,Purchases.Milk
  ,Purchases.SchoolNum
  ,Purchases.ProgramYear
  ,District.DistrictName
  ,Vendors.VENDNAME
FROM
  Purchases
  INNER JOIN District
    ON Purchases.DistrictID = District.DistrictID
  LEFT OUTER JOIN Vendors
    ON Purchases.VendorID = Vendors.VENDORID
WHERE
  Purchases.DistrictID LIKE @DistrictID
  AND Purchases.PostDate &gt;= @PostDate
  AND Purchases.PostDate &lt;= @PostDate2
  AND Vendors.INTERID = N'NUTR1'</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <AutoJoin>False</AutoJoin>
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Purchases" ColumnName="DistrictID" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="InvoiceDate" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="PostDate" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="VendorID" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="InvoiceNumber" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Groceries" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Paper" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Cleaning" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Other" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="OtherCategoryID" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Counter" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Imported" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="ImportDate" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="PurchaseComments" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="Milk" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="SchoolNum" />
              <ColumnExpression ColumnOwner="Purchases" ColumnName="ProgramYear" />
              <ColumnExpression ColumnOwner="District" ColumnName="DistrictName" />
              <ColumnExpression ColumnOwner="Vendors" ColumnName="VENDNAME" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="Purchases" />
              <Join Type="INNER JOIN" ColumnOwner="District">
                <On>
                  <From ColumnOwner="Purchases" ColumnName="DistrictID" />
                  <To ColumnOwner="District" ColumnName="DistrictID" />
                </On>
              </Join>
              <Join Type="LEFT OUTER JOIN" ColumnOwner="Vendors">
                <On>
                  <From ColumnOwner="Purchases" ColumnName="VendorID" />
                  <To ColumnOwner="Vendors" ColumnName="VENDORID" />
                </On>
              </Join>
            </Joins>
            <Filters>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="Purchases" ColumnName="DistrictID" />
              </Filter>
              <Filter Operator="&gt;=" Param="True">
                <ColumnExpression ColumnOwner="Purchases" ColumnName="PostDate" />
              </Filter>
              <Filter Operator="&lt;=" Param="True">
                <ColumnExpression ColumnOwner="Purchases" ColumnName="PostDate" />
              </Filter>
              <Filter Operator="=">
                <ColumnExpression ColumnOwner="Vendors" ColumnName="INTERID" />
                <FilterValue>NUTR1</FilterValue>
              </Filter>
            </Filters>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
