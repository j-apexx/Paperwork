    <DataSet Name="DataSetInventory">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProgramYear">
            <Value>=Parameters!ProgramYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@YearMonth">
            <Value>=Parameters!YearMonth.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  Inventory.ProgramYear
  ,Inventory.DistrictID
  ,Inventory.YearMonth
  ,Inventory.USDAProteinOpen
  ,Inventory.USDAProteinRcvd
  ,Inventory.USDAProteinInstUse
  ,Inventory.USDAProteinTrans
  ,Inventory.USDAProteinEnding
  ,Inventory.USDAGroceryOpen
  ,Inventory.USDAGroceryRcvd
  ,Inventory.USDAGroceryInstUse
  ,Inventory.USDAGroceryTrans
  ,Inventory.USDAGroceryEnding
FROM
  Inventory
WHERE
  Inventory.ProgramYear LIKE @ProgramYear
  AND Inventory.DistrictID LIKE @DistrictID
  AND Inventory.YearMonth LIKE @YearMonth</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Inventory" ColumnName="ProgramYear" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="DistrictID" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="YearMonth" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="USDAProteinOpen" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="USDAProteinRcvd" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="USDAProteinInstUse" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="USDAProteinTrans" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="USDAProteinEnding" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="USDAGroceryOpen" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="USDAGroceryRcvd" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="USDAGroceryInstUse" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="USDAGroceryTrans" />
              <ColumnExpression ColumnOwner="Inventory" ColumnName="USDAGroceryEnding" />
            </SelectedColumns>
            <Filters>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="Inventory" ColumnName="ProgramYear" />
              </Filter>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="Inventory" ColumnName="DistrictID" />
              </Filter>
              <Filter Operator="LIKE" Param="True">
                <ColumnExpression ColumnOwner="Inventory" ColumnName="YearMonth" />
              </Filter>
            </Filters>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
      <Fields>
        <Field Name="ProgramYear">
          <DataField>ProgramYear</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DistrictID">
          <DataField>DistrictID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="YearMonth">
          <DataField>YearMonth</DataField>
          <rd:TypeName>System.String</rd:TypeName>
