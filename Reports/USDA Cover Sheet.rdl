    <DataSet Name="DataSetInvYearMonths">
      <Query>
        <DataSourceName>DataSourcePaperwork</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProgramYear">
            <Value>=Parameters!ProgramYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DistrictID">
            <Value>=Parameters!DistrictID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  Inventory.YearMonth
FROM
  Inventory
WHERE
  Inventory.ProgramYear LIKE @ProgramYear
  AND Inventory.DistrictID LIKE @DistrictID
ORDER BY Inventory.YearMonth</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="YearMonth">
          <DataField>YearMonth</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
